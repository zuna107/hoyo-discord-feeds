NODE_ENV=development
PORT=8080
ROLE=all
LOG_TO_CONSOLE=true
DB_PATH=./data/feed-engine.db
CORS_ORIGIN=*
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_SETUP_KEY=change-this-setup-key
DASHBOARD_AUTH_ISSUER=Hoyo Feed Engine
DASHBOARD_AUTH_ACCOUNT=dashboard-admin
DASHBOARD_SESSION_SECRET=change-this-session-secret
DASHBOARD_SESSION_TTL_HOURS=24
SCHEDULER_TICK_CRON=*/30 * * * * *
DISPATCH_BATCH_SIZE=25
DISPATCH_CONCURRENCY=5
MAX_POST_AGE_HOURS=24
SUBSCRIPTION_BACKFILL_COUNT=1
MAX_RETRY_ATTEMPTS=6
RETRY_BASE_MS=5000

# Optional API keys
TWITTER_BEARER_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_API_FALLBACK_ENABLED=false
HOYOLAB_ENDPOINT=
HOYOLAB_LANGUAGE=en-us
HOYOLAB_APP_VERSION=3.9.0

# Optional fallback scraping (disabled by default)
FALLBACK_SCRAPING_ENABLED=false
