{
  "name": "hoyo-discord-feeds",
  "version": "0.1.0",
  "private": true,
  "description": "Universal multi-source feed distributor for Discord webhooks",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "check": "tsc --noEmit",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^4.2.1",
    "otplib": "^12.0.1",
    "p-limit": "^6.2.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
